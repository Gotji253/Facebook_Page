OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_API_VERSION=v23.0
FONT_PATH=fonts/NotoSansThai-Regular.ttf
STATE_FILE=state.json
OUTPUT_IMAGE=output/latest.jpg
IMAGE_PROVIDER=auto
IMAGE_MIN_WIDTH=900
IMAGE_MIN_HEIGHT=500
REDDIT_SUBREDDIT=soccer
# Optional keys; provider chain skips services without keys
# UNSPLASH_ACCESS_KEY=
# ใช้ | คั่นคำค้นสำรองเมื่อ headline ไม่พบภาพ
UNSPLASH_FALLBACK_QUERIES=Tottenham football|Manchester City football|football stadium|soccer match
# BING_IMAGE_SEARCH_KEY=
# GOOGLE_CUSTOM_SEARCH_KEY=
# GOOGLE_CUSTOM_SEARCH_CX=
LOG_LEVEL=INFO
# Optional RSS overrides:
# RSS_BBC_URL=https://feeds.bbci.co.uk/sport/football/rss.xml
# RSS_ESPN_URL=https://www.espn.com/espn/rss/soccer/news
# RSS_GOAL_URL=https://www.goal.com/feeds/en/news
